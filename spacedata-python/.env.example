# Copie ce fichier vers ".env" (à la racine du projet) et renseigne tes propres identifiants.
# Le fichier ".env" ne doit jamais être commité (il est déjà ignoré par .gitignore).

# Identifiants Copernicus Data Space Ecosystem (compte gratuit)
# Créer un compte : https://dataspace.copernicus.eu/
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Token NASA Earthdata Login (compte gratuit)
# Créer un compte : https://urs.earthdata.nasa.gov/
# Générer un token : https://urs.earthdata.nasa.gov/users/<ton_login>/user_tokens
EARTHDATA_TOKEN=

# Clé API factice utilisée par la micro-API de la séance 2 (libre, choisis ce que tu veux)
MICRO_API_KEY=cle-secrete-tp2
